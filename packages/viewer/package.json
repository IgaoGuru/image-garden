{
  "name": "@constellation/viewer",
  "version": "0.1.0",
  "description": "Flyable 3D image embedding constellation viewer",
  "type": "module",
  "main": "./dist/constellation-viewer.umd.cjs",
  "module": "./dist/constellation-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/constellation-viewer.js",
      "require": "./dist/constellation-viewer.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vite build && node scripts/smoke.mjs",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "three": "^0.181.2",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/three": "^0.181.0",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
