{
  "name": "@image-garden/viewer",
  "version": "0.1.0",
  "description": "Reusable flyable 3D viewer for positioned image maps",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/IgaoGuru/image-garden#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgaoGuru/image-garden.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/IgaoGuru/image-garden/issues"
  },
  "keywords": [
    "image",
    "embeddings",
    "threejs",
    "webgl",
    "viewer",
    "umap",
    "lod"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/image-garden-viewer.umd.cjs",
  "module": "./dist/image-garden-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/image-garden-viewer.js",
      "require": "./dist/image-garden-viewer.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vite build && node scripts/smoke.mjs",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "three": "^0.181.2",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/three": "^0.181.0",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
